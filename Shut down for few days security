-- ==========================================
-- 2. Animations (TweenService)
-- ==========================================

-- Entrance Animation (Pop up effect)
local openTween = TweenService:Create(uiScale, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Scale = 1})
openTween:Play()

-- Close Button Hover Effect
local hoverInfo = TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
closeBtn.MouseEnter:Connect(function()
	TweenService:Create(closeBtn, hoverInfo, {TextColor3 = Color3.fromRGB(255, 75, 75)}):Play()
end)

closeBtn.MouseLeave:Connect(function()
	TweenService:Create(closeBtn, hoverInfo, {TextColor3 = Color3.fromRGB(150, 150, 150)}):Play()
end)

-- Close Button Click Logic
closeBtn.MouseButton1Click:Connect(function()
	local closeTween = TweenService:Create(uiScale, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {Scale = 0})
	closeTween:Play()
	
	-- Destroy the GUI after the animation finishes
	closeTween.Completed:Connect(function()
		screenGui:Destroy()
	end)
end)


-- ==========================================
-- 3. Professional Custom Dragging Logic
-- ==========================================

local dragging
local dragInput
local dragStart
local startPos

local function updateInput(input)
	local delta = input.Position - dragStart
	-- Smooth dragging tween instead of snapping
	TweenService:Create(mainFrame, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	}):Play()
end

mainFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

mainFrame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		updateInput(input)
	end
end)
