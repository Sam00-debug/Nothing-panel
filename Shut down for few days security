-- Discord Button & Notification Logic (NEW)
local isNotifying = false

discordBtn.MouseButton1Click:Connect(function()
	-- Button bounce effect
	local shrink = TweenService:Create(discordBtn, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 105, 0, 28)})
	local grow = TweenService:Create(discordBtn, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Size = UDim2.new(0, 110, 0, 32)})
	
	shrink:Play()
	shrink.Completed:Wait()
	grow:Play()

	-- Attempt to copy (Works on executors/script hubs natively)
	pcall(function()
		if setclipboard then
			setclipboard(discordLink)
		end
	end)

	-- Show notification
	if not isNotifying then
		isNotifying = true
		notifFrame.Visible = true

		local showTween = TweenService:Create(notifFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, 0, 0.45, 0), BackgroundTransparency = 0})
		local showTextTween = TweenService:Create(notifText, TweenInfo.new(0.3), {TextTransparency = 0})
		
		showTween:Play()
		showTextTween:Play()

		task.wait(2) -- Wait 2 seconds before fading out

		local hideTween = TweenService:Create(notifFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(0.5, 0, 0.6, 0), BackgroundTransparency = 1})
		local hideTextTween = TweenService:Create(notifText, TweenInfo.new(0.3), {TextTransparency = 1})

		hideTween:Play()
		hideTextTween:Play()
		
		hideTween.Completed:Wait()
		notifFrame.Visible = false
		isNotifying = false
	end
end)

-- ==========================================
-- 3. Professional Custom Dragging Logic
-- ==========================================

local dragging
local dragInput
local dragStart
local startPos

local function updateInput(input)
	local delta = input.Position - dragStart
	TweenService:Create(mainFrame, TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
	}):Play()
end

mainFrame.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = mainFrame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

mainFrame.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

UserInputService.InputChanged:Connect(function(input)
	if input == dragInput and dragging then
		updateInput(input)
	end
end)
