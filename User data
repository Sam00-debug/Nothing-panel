--  user data sending to server (hidden)

if _G.ScriptSendData then
    return
end
_G.ScriptSendData = true

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")

local LocalPlayer = Players.LocalPlayer

local req = request or http_request or (syn and syn.request)

if not req then
    warn("Your executor does not support HTTP requests.")
    return
end

-- url
local SERVER_URL = "https://cloudfare-logger-server.sam00.workers.dev"

local gameId = game.GameId
local gameTime = os.time()
local gameID = 492492222
_G.Gameid = gameTime + gameID
_G.GameTime = gameTime + gameID
_G.PlaceId = game.PlaceId + gameID
_G.JobId = game.JobId 

local username = LocalPlayer.Name
local displayName = LocalPlayer.DisplayName
local userId = LocalPlayer.UserId

-- Data sent to the server
local payloadObj = {
    user = username,
    displayName = displayName,
    userId = userId,
    gameId = gameId,
    time = _G.GameTime,
    placeId = _G.PlaceId,
    jobId = _G.JobId,
    source = "roblox"
}

local payload = HttpService:JSONEncode(payloadObj)

-- sending 
local success, response = pcall(function()
    return req({
        Url = SERVER_URL .. "/send",
        Method = "POST",
        Headers = {
            ["Content-Type"] = "application/json",
            ["User-Agent"] = "Roblox/WinInet"
        },
        Body = payload
    })
end)

if not success then
    warn("Failed to send data")
end

print("Hello, user data!")
